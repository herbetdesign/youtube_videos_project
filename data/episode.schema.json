{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/financial-animation-kit/episode.schema.json",
  "title": "Financial Animation Episode",
  "type": "object",
  "required": ["episode_id", "title", "resolution", "fps", "scenes"],
  "properties": {
    "episode_id": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "const": 1920}, "height": {"type": "integer", "const": 1080}},
      "additionalProperties": false
    },
    "fps": {"type": "integer", "minimum": 1, "maximum": 30},
    "audio": {"type": "object", "properties": {"voiceover": {"type": ["string", "null"]}, "music": {"type": ["string", "null"]}}},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "duration_seconds", "background", "character", "expression", "movement", "narration"],
        "properties": {
          "id": {"type": "string"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "background": {"type": "string"},
          "character": {"type": "string"},
          "expression": {"type": "string"},
          "movement": {"type": "string"},
          "position": {"type": "object", "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "scale": {"type": "number", "minimum": 0.1, "maximum": 3}}},
          "objects": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}, "rotate": {"type": "number"}}}},
          "camera": {"type": "string"}, "text_overlay": {"type": "string"}, "narration": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
