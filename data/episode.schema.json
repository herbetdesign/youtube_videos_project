{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Animation Episode — 2D Blocky",
  "type": "object",
  "required": [
    "episode_id",
    "title",
    "resolution",
    "fps",
    "scenes"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resolution": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        }
      }
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_seconds",
          "background",
          "character",
          "expression",
          "movement",
          "narration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "background": {
            "type": "string"
          },
          "character": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "movement": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scale": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 2
              }
            }
          },
          "outfit": {
            "type": "string"
          },
          "accessories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "rotate": {
                  "type": "number"
                }
              }
            }
          },
          "camera": {
            "type": "string"
          },
          "text_overlay": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}